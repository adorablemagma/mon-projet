pipeline {
    agent any

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/adorablemagma/mon-projet.git',
                    branch: 'main'
            }
        }

        stage('Build') {
            steps {
                bat 'echo === BUILD ==='
                bat 'dir'
                bat 'echo Preparation du projet terminee'
            }
        }

        stage('Test') {
            steps {
                bat 'echo === TEST ==='
                bat 'git status'
                bat 'echo Tests termines avec succes'
		  sh 'grep -q "<html" index.html'
                sh 'grep -q "<h1" index.html'
            }
        }

        stage('Deploy') {
            steps {
                bat 'echo === DEPLOY ==='
                bat 'echo Le fichier index.html est pret a etre affiche'
                bat 'echo Deploiement simule avec succes'
            }
        }
    }

    post {
        success {
            echo 'Build OK'
        }
        failure {
            echo 'Build KO'
        }
    }
}
